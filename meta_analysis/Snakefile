# ============================================================
# Meta-analysis: one table with the DEGs of every DE project in the repository.
# Reads each project's results/top_table.csv and results/de_summary.tsv (paths in config.yaml) and
# writes results/all_degs.csv: one row per gene per dataset where it is a DEG, with symbol, Entrez ID,
# Ensembl ID, log2FC, statistic, p-value and padj.
#
# Genes are matched across datasets and species by results/gene_map.csv: every tested gene with a key
# (the mouse Ensembl ID; rat genes get the one of their 1:1 ortholog from Ensembl Compara, downloaded once
# by the `orthologs` rule into cache/compara/; needs internet on the first run).
#
# plots/ and results/pairwise_overlap.csv show the DEG overlap between datasets, and reports/report.html
# explains everything. Shared scripts: ../scripts/meta/ (collect_degs.R, plots.py, report.py).
#
# Requires Snakemake 9. Usage (from this folder):
#   conda activate genomic-variants
#   snakemake -n --use-conda
#   snakemake --use-conda --cores 1
# ============================================================

configfile: "config.yaml"

ENV = "envs/limma.yaml"
ENV_REPORT = "envs/report.yaml"
ENV_META = "envs/metafor.yaml"
DATASETS = config["datasets"]
ORTHO = config["orthologs"]
ORTHO_FILES = [f"cache/compara/{sp}/{f}" for sp, files in ORTHO["files"].items() for f in files]
TOP_TABLES = [f"{d['project']}/results/top_table.csv" for d in DATASETS.values()]


rule all:
    input:
        "results/gene_map.csv",
        "results/all_degs.csv",
        "results/pairwise_overlap.csv",
        "results/meta_random_effects.csv",
        "reports/report.html",


# ------------------------------------------------------------
# Orthologs: Ensembl Compara homology tables (one download per file; delete cache/compara/ to refresh).
# ------------------------------------------------------------
rule orthologs:
    output:
        "cache/compara/{species}/{file}",
    wildcard_constraints:
        file=r"Compara\.[0-9]+\.[a-z_]+\.homologies\.tsv\.gz",
    params:
        url=lambda wc: f"{ORTHO['url']}/{wc.species}/{wc.file}",
    log:
        "logs/orthologs/{species}/{file}.log",
    shell:
        """
        (date -Iseconds
         curl -fsS --retry 10 --retry-all-errors --retry-delay 30 -C - -m 3600 \\
             -o {output}.part {params.url}
         gzip -t {output}.part
         mv {output}.part {output}
         ls -l {output}) > {log} 2>&1
        """


rule gene_map:
    input:
        top_tables=TOP_TABLES,
        homologies=ORTHO_FILES,
    output:
        table="results/gene_map.csv",
    conda:
        ENV
    log:
        "logs/gene_map.log",
    script:
        "../scripts/meta/gene_map.R"


rule collect_degs:
    input:
        top_tables=TOP_TABLES,
        gene_map="results/gene_map.csv",
        summaries=[f"{d['project']}/results/de_summary.tsv" for d in DATASETS.values()],
    output:
        table="results/all_degs.csv",
        session="reports/sessionInfo.txt",
    conda:
        ENV
    log:
        "logs/collect_degs.log",
    script:
        "../scripts/meta/collect_degs.R"


# ------------------------------------------------------------
# Random-effects meta-analysis per gene (metafor), on log2FC / lfcSE of every dataset.
# ------------------------------------------------------------
rule meta_random_effects:
    input:
        top_tables=TOP_TABLES,
        gene_map="results/gene_map.csv",
        degs="results/all_degs.csv",
    output:
        table="results/meta_random_effects.csv",
        session="reports/sessionInfo_metafor.txt",
    conda:
        ENV_META
    log:
        "logs/meta_random_effects.log",
    script:
        "../scripts/meta/meta_random_effects.R"


rule plots:
    input:
        degs="results/all_degs.csv",
        gene_map="results/gene_map.csv",
        meta="results/meta_random_effects.csv",
    output:
        overlap="results/pairwise_overlap.csv",
        deg_counts="plots/deg_counts.png",
        shared_lfc="plots/shared_degs_lfc.png",
        meta_volcano="plots/meta_volcano.png",
        meta_forest="plots/meta_forest.png",
    conda:
        ENV_REPORT
    log:
        "logs/plots.log",
    script:
        "../scripts/meta/plots.py"


rule report:
    input:
        degs="results/all_degs.csv",
        gene_map="results/gene_map.csv",
        overlap=rules.plots.output.overlap,
        deg_counts=rules.plots.output.deg_counts,
        shared_lfc=rules.plots.output.shared_lfc,
        meta="results/meta_random_effects.csv",
        meta_volcano=rules.plots.output.meta_volcano,
        meta_forest=rules.plots.output.meta_forest,
        summaries=[f"{d['project']}/results/de_summary.tsv" for d in DATASETS.values()],
        session=["reports/sessionInfo.txt", "reports/sessionInfo_metafor.txt"],
        config="config.yaml",
        envs=["envs/limma.yaml", "envs/metafor.yaml", "envs/report.yaml"],
        scripts=["../scripts/html_report.py"],
        code=["../scripts/meta/plots.py"],
    output:
        html="reports/report.html",
    conda:
        ENV_REPORT
    log:
        "logs/report.log",
    script:
        "../scripts/meta/report.py"
