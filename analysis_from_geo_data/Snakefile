# ============================================================
# Bulk RNA-seq analysis pipeline
# Dataset: GSE178812
#
# Requires Snakemake 9. Usage (from this folder):
#   conda activate genomic-variants        # Snakemake 9
#   snakemake -n --use-conda               # dry-run
#   snakemake --use-conda --cores 1
#
# The R environment (rna-seq) is built from envs/rna-seq.yaml, pinned to the
# exact package versions in envs/rna-seq.linux-64.pin.txt. The report uses the
# Python environment in envs/report.yaml.
# ============================================================

ENV = "envs/rna-seq.yaml"
ENV_REPORT = "envs/report.yaml"


# ------------------------------------------------------------
# Complete pipeline
# ------------------------------------------------------------

rule all:
    input:
        # Prepared data
        "data/counts.csv",
        "data/colData.csv",

        # Differential expression
        "results/top_table.csv",

        # QC plots
        "plots/pca_vst.png",
        "plots/volcano.png",
        "plots/heatmap.png",
        "plots/fdr_histogram.png",
        "plots/boxplot.png",
        "plots/QQPlot.png",
        "plots/MAplot.png",
        "plots/dispersion_plot.png",
        "plots/density_counts.png",
        "plots/cooks_distance.png",

        # Functional enrichment
        "results/GSEA_GO_all_full.csv",
        "results/GSEA_KEGG_full.csv",
        "results/enrichment_STRING_full.csv",
        "results/edges_PPI.csv",
        "results/nodes_PPI.csv",

        # Report
        "reports/report.html",


# ------------------------------------------------------------
# Step 00: Packages and configuration
# ------------------------------------------------------------

rule packages:
    output:
        touch(".pipeline/packages.done"),
    conda:
        ENV
    log:
        "logs/packages.log",
    shell:
        "Rscript scripts/00_packages.R > {log} 2>&1"


# ------------------------------------------------------------
# Step 01: Data acquisition and preparation
# ------------------------------------------------------------

rule prepare:
    input:
        packages=".pipeline/packages.done",
    output:
        counts="data/counts.csv",
        coldata="data/colData.csv",
    conda:
        ENV
    log:
        "logs/prepare.log",
    shell:
        "Rscript scripts/01_download_and_prepare.R > {log} 2>&1"


# ------------------------------------------------------------
# Step 02: Quality control and differential expression
# ------------------------------------------------------------

rule differential:
    input:
        counts="data/counts.csv",
        coldata="data/colData.csv",
    output:
        top_table="results/top_table.csv",

        # QC plots
        pca="plots/pca_vst.png",
        volcano="plots/volcano.png",
        heatmap="plots/heatmap.png",
        fdr="plots/fdr_histogram.png",
        boxplot="plots/boxplot.png",
        qqplot="plots/QQPlot.png",
        ma="plots/MAplot.png",
        dispersion="plots/dispersion_plot.png",
        density="plots/density_counts.png",
        cooks="plots/cooks_distance.png",
    conda:
        ENV
    log:
        "logs/differential.log",
    shell:
        "Rscript scripts/02_differential_expression_and_qc.R > {log} 2>&1"


# ------------------------------------------------------------
# Step 03: Functional enrichment analysis
# ------------------------------------------------------------

rule enrichment:
    input:
        top_table="results/top_table.csv",
        counts="data/counts.csv",
        coldata="data/colData.csv",
    output:
        go="results/GSEA_GO_all_full.csv",
        kegg="results/GSEA_KEGG_full.csv",
        string="results/enrichment_STRING_full.csv",
        edges="results/edges_PPI.csv",
        nodes="results/nodes_PPI.csv",
    conda:
        ENV
    log:
        "logs/enrichment.log",
    shell:
        "Rscript scripts/03_enrichment.R > {log} 2>&1"


# ------------------------------------------------------------
# Step 04: HTML report of the whole analysis (plots/ + results/)
# ------------------------------------------------------------

rule report:
    input:
        coldata="data/colData.csv",
        top_table="results/top_table.csv",
        plots=[f for k, f in rules.differential.output.items() if f.endswith(".png")],
        go="results/GSEA_GO_all_full.csv",
        kegg="results/GSEA_KEGG_full.csv",
        string="results/enrichment_STRING_full.csv",
        edges="results/edges_PPI.csv",
        nodes="results/nodes_PPI.csv",
        scripts=["scripts/report.py", "scripts/html_report.py"],
    output:
        html="reports/report.html",
    params:
        title="GSE178812: differential expression and enrichment",
        subtitle="Doxorubicin (CHEM) vs vehicle (VEH), mouse hippocampus",
        reference="VEH",
        treatment="CHEM",
        padj=0.05,
        lfc=0.5,
        design="""
Hippocampus of young C57BL/6J mice treated with doxorubicin (**CHEM**) or vehicle (**VEH**)
(GEO GSE178812, PMID 34147619). The series also has a doxorubicin + MitoQ group, which is not used here.
""",
        notes="",
        pipeline="""
1. **packages**: checks that the R packages of the `rna-seq` environment load.
2. **prepare**: downloads the count table (`GSE178812_Doxo-counts.xlsx`) and the series matrix from GEO
   and writes `data/counts.csv` and `data/colData.csv`.
3. **differential**: filtering, DESeq2 fit (`DESeqDataSetFromMatrix`, `~ group`) and the QC/DE plots.
4. **enrichment**: GSEA (GO, KEGG), pathview map, STRING network and enrichment.
5. **report**: this page.
""",
        filter_text="genes with ≥ 10 counts in at least 3 samples.",
        input_text="""
The analysis starts from the count table deposited by the authors in GEO (gene symbols × samples), so raw
reads are not processed here. Gene symbols are used as identifiers.
""",
        upstream_qc="",
        config_text="",
    conda:
        ENV_REPORT
    log:
        "logs/report.log",
    script:
        "scripts/report.py"
