# RNA-seq GSE295281: .sra (NCBI/AWS) -> fastq -> FastQC -> Salmon -> gene-level count table (tximport).
# Usage (env genomic-variants, Snakemake 9):
#   snakemake -n --use-conda
#   snakemake --use-conda --cores 8 --resources download=3 scratch_dump=1

import csv
import os

configfile: "config.yaml"

if "DATA" not in os.environ:
    raise ValueError("Environment variable DATA is not set (large files are stored under $DATA).")
D = os.path.join(os.environ["DATA"], config["data_subdir"])
# Temporary FASTQ files on the local SSD (see config.yaml).
S = os.path.expanduser(config["fastq_scratch"])

with open(config["samples"]) as f:
    SAMPLES = {row["run"]: row for row in csv.DictReader(f, delimiter="\t")}
RUNS = sorted(SAMPLES)

REL = config["gencode_release"]
TRANSCRIPTOME = f"{D}/ref/gencode.v{REL}.transcripts.fa.gz"
INDEX = f"{D}/ref/salmon_index_gencode_v{REL}"
SALMON_THREADS = config["threads"]["salmon"]

wildcard_constraints:
    run="|".join(RUNS),
    read="[12]",


rule all:
    input:
        "results/counts_gene.tsv",
        "results/counts_gene_lengthScaledTPM.tsv",
        "results/tpm_gene.tsv",
        "results/qc_summary.tsv",
        "reports/multiqc_report.html",
        "reports/sessionInfo.txt",
        "reports/report.html",


# ---------------------------------------------------------------- download

rule download_sra:
    # Public NCBI mirror on AWS S3 (ENA is far too slow from here: ~KB/s).
    output:
        f"{D}/sra/{{run}}.sra",
    params:
        url=lambda w: f"https://sra-pub-run-odp.s3.amazonaws.com/sra/{w.run}/{w.run}",
    resources:
        download=1,
    conda:
        "envs/sratools.yaml"
    log:
        "logs/download_sra/{run}.log",
    shell:
        """
        curl -fsSL --retry 10 --retry-all-errors --retry-delay 30 -C - \\
            -o {output}.part {params.url} 2> {log}
        vdb-validate {output}.part >> {log} 2>&1
        mv {output}.part {output}
        """


rule fasterq_dump:
    # Uncompressed FASTQ is temporary and lives on the SSD: deleted after FastQC and Salmon. The .sra (HD) is the raw copy.
    # resources scratch_dump=1 (via --resources): one fasterq-dump at a time, to limit SSD usage.
    input:
        f"{D}/sra/{{run}}.sra",
    output:
        r1=temp(f"{S}/fastq/{{run}}_1.fastq"),
        r2=temp(f"{S}/fastq/{{run}}_2.fastq"),
    threads: config["threads"]["fasterq_dump"]
    resources:
        scratch_dump=1,
    conda:
        "envs/sratools.yaml"
    log:
        "logs/fasterq_dump/{run}.log",
    shell:
        """
        fasterq-dump {input} --split-files --threads {threads} \\
            --outdir {S}/fastq --temp {S}/tmp &> {log}
        """


rule download_transcriptome:
    output:
        TRANSCRIPTOME,
    params:
        url=config["transcriptome_url"],
    resources:
        download=1,
    log:
        "logs/download_transcriptome/download.log",
    shell:
        """
        curl -fsSL --retry 5 --retry-delay 30 -o {output}.part {params.url} 2> {log}
        gzip -t {output}.part
        mv {output}.part {output}
        """


# ---------------------------------------------------------------- QC

rule fastqc:
    input:
        f"{S}/fastq/{{run}}_{{read}}.fastq",
    output:
        html=f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.html",
        zip=f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.zip",
    threads: config["threads"]["fastqc"]
    priority: 5
    conda:
        "envs/qc.yaml"
    log:
        "logs/fastqc/{run}_{read}.log",
    shell:
        "fastqc --threads {threads} --outdir {D}/qc/fastqc {input} &> {log}"


rule multiqc:
    input:
        expand(f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.zip", run=RUNS, read=[1, 2]),
        expand(f"{D}/salmon/{{run}}/quant.sf", run=RUNS),
    output:
        "reports/multiqc_report.html",
    conda:
        "envs/qc.yaml"
    log:
        "logs/multiqc/multiqc.log",
    shell:
        """
        multiqc --force --no-data-dir --filename multiqc_report.html --outdir reports \
            {D}/qc/fastqc {D}/salmon &> {log}
        """


# ---------------------------------------------------------------- Salmon

rule salmon_index:
    input:
        TRANSCRIPTOME,
    output:
        directory(INDEX),
    threads: SALMON_THREADS
    conda:
        "envs/salmon.yaml"
    log:
        "logs/salmon_index/index.log",
    shell:
        "salmon index -t {input} -i {output} -k 31 --gencode -p {threads} &> {log}"


rule salmon_quant:
    input:
        r1=f"{S}/fastq/{{run}}_1.fastq",
        r2=f"{S}/fastq/{{run}}_2.fastq",
        index=INDEX,
    output:
        quant=f"{D}/salmon/{{run}}/quant.sf",
        meta=f"{D}/salmon/{{run}}/aux_info/meta_info.json",
        libfmt=f"{D}/salmon/{{run}}/lib_format_counts.json",
    params:
        outdir=f"{D}/salmon/{{run}}",
    threads: SALMON_THREADS
    # High priority: consume temporary FASTQ before new ones are generated (otherwise they pile up).
    priority: 10
    conda:
        "envs/salmon.yaml"
    log:
        "logs/salmon_quant/{run}.log",
    shell:
        """
        salmon quant -i {input.index} -l A \
            -1 {input.r1} -2 {input.r2} \
            -p {threads} --gcBias --seqBias \
            -o {params.outdir} &> {log}
        """


rule check_mapping_rate:
    input:
        f"{D}/salmon/{{run}}/aux_info/meta_info.json",
    output:
        f"{D}/salmon/{{run}}/mapping_ok.txt",
    params:
        min_rate=config["min_mapping_rate"],
    log:
        "logs/check_mapping_rate/{run}.log",
    run:
        import json

        rate = json.load(open(input[0]))["percent_mapped"]
        msg = f"{wildcards.run}: mapping rate = {rate:.2f}% (minimum {params.min_rate}%)"
        with open(log[0], "w") as f:
            f.write(msg + "\n")
        if rate < params.min_rate:
            raise ValueError("Mapping rate too low -- " + msg)
        with open(output[0], "w") as f:
            f.write(msg + "\n")


# ---------------------------------------------------------------- count table

rule tx2gene:
    input:
        TRANSCRIPTOME,
    output:
        "data/tx2gene.tsv",
    log:
        "logs/tx2gene/tx2gene.log",
    shell:
        "python3 ../scripts/raw/tx2gene.py {input} {output} &> {log}"


rule qc_summary:
    input:
        samples=config["samples"],
        meta=expand(f"{D}/salmon/{{run}}/aux_info/meta_info.json", run=RUNS),
        libfmt=expand(f"{D}/salmon/{{run}}/lib_format_counts.json", run=RUNS),
    output:
        "results/qc_summary.tsv",
    params:
        salmon_dir=f"{D}/salmon",
    log:
        "logs/qc_summary/qc_summary.log",
    shell:
        "python3 ../scripts/raw/qc_summary.py {input.samples} {params.salmon_dir} {output} &> {log}"


rule tximport:
    input:
        samples=config["samples"],
        tx2gene="data/tx2gene.tsv",
        quant=expand(f"{D}/salmon/{{run}}/quant.sf", run=RUNS),
        ok=expand(f"{D}/salmon/{{run}}/mapping_ok.txt", run=RUNS),
    output:
        counts="results/counts_gene.tsv",
        scaled="results/counts_gene_lengthScaledTPM.tsv",
        tpm="results/tpm_gene.tsv",
        length="results/length_gene.tsv",
        rds="data/txi_gene.rds",
    params:
        salmon_dir=f"{D}/salmon",
    conda:
        "envs/tximport.yaml"
    log:
        "logs/tximport/tximport.log",
    shell:
        """
        Rscript ../scripts/raw/tximport.R {input.samples} {params.salmon_dir} {input.tx2gene} \
            {output.counts} {output.scaled} {output.tpm} {output.length} {output.rds} &> {log}
        """


# ---------------------------------------------------------------- figures and report

QC_PLOTS = [
    "qc_reads_mapping", "fastqc_module_status", "fastqc_per_base_quality", "fastqc_gc_content",
    "fastqc_adapter_content", "count_composition", "detected_genes", "top_expressed_genes",
    "sample_correlation", "pca_logcpm",
]
QC_TABLES = ["count_composition", "fastqc_module_status", "top_expressed_genes",
             "sample_correlation_logcpm", "pca_logcpm"]


rule qc_plots:
    input:
        samples=config["samples"],
        qc="results/qc_summary.tsv",
        counts="results/counts_gene.tsv",
        tx2gene="data/tx2gene.tsv",
        fastqc=expand(f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.zip", run=RUNS, read=[1, 2]),
    output:
        plots=expand("plots/{name}.png", name=QC_PLOTS),
        tables=expand("results/{name}.tsv", name=QC_TABLES),
    params:
        fastqc_dir=f"{D}/qc/fastqc",
    conda:
        "envs/report.yaml"
    log:
        "logs/qc_plots/qc_plots.log",
    shell:
        """
        python3 ../scripts/raw/qc_plots.py {input.samples} {input.qc} {input.counts} {input.tx2gene} \
            {params.fastqc_dir} plots results &> {log}
        """


rule session_info:
    # R session of the tximport environment (the only R step of this project).
    output:
        "reports/sessionInfo.txt",
    conda:
        "envs/tximport.yaml"
    log:
        "logs/session_info/session_info.log",
    shell:
        """
        Rscript -e 'suppressMessages({{library(tximport); library(readr); library(jsonlite)}}); \
                    writeLines(capture.output(sessionInfo()), "{output}")' > {log} 2>&1
        """


rule report:
    input:
        samples=config["samples"],
        qc="results/qc_summary.tsv",
        counts="results/counts_gene.tsv",
        composition="results/count_composition.tsv",
        fastqc_status="results/fastqc_module_status.tsv",
        top_genes="results/top_expressed_genes.tsv",
        correlation="results/sample_correlation_logcpm.tsv",
        reads_plot="plots/qc_reads_mapping.png",
        plots=expand("plots/{name}.png", name=QC_PLOTS),
        multiqc="reports/multiqc_report.html",
        envs=["envs/qc.yaml", "envs/report.yaml", "envs/salmon.yaml", "envs/sratools.yaml", "envs/tximport.yaml"],
        config="config.yaml",
        session="reports/sessionInfo.txt",
        scripts=["../scripts/html_report.py"],
        code=["../scripts/raw/qc_plots.py"],
        report_script=["../scripts/raw/report.py"],
    output:
        html="reports/report.html",
    conda:
        "envs/report.yaml"
    log:
        "logs/report/report.log",
    script:
        "../scripts/raw/report.py"
